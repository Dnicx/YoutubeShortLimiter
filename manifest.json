{
  "manifest_version": 3,
  "name": "YouTube Shorts Limiter",
  "version": "1.0.0",
  "description": "Limit your YouTube Shorts doom scrolling with time/count limits and cool-down periods",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.youtube.com/shorts*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
